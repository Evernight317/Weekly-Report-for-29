# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 排除，不会提交）

# 大模型：OpenAI 兼容接口（本项目使用第三方代理，也可替换为任意兼容服务）
DEEPSEEK_API_KEY=sk-你的模型服务Key
DEEPSEEK_url=https://你的服务地址/v1

# LangSmith 追踪（可选，不填则不上报 trace）
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_你的LangSmithKey
LANGCHAIN_PROJECT=sky-ai-assistant

# 苍穹外卖后端地址（可选，默认 http://localhost:8080）
# SKY_BASE_URL=http://localhost:8080
